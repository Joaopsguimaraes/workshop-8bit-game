diff --git a/lib/engine/prisma.ts b/lib/engine/prisma.ts
index 8c3d1db..3a8e00b 100644
--- a/lib/engine/prisma.ts
+++ b/lib/engine/prisma.ts
@@ -1,6 +1,20 @@
 import { PrismaBetterSqlite3 } from "@prisma/adapter-better-sqlite3";
 import { PrismaClient } from "../../generated/prisma/client";
+import { caller, queries, queryMs } from "../instrumentation";
 
 export function createPrismaClient(url: string) {
-  return new PrismaClient({ adapter: new PrismaBetterSqlite3({ url }) });
+  const base = new PrismaClient({ adapter: new PrismaBetterSqlite3({ url }) });
+  return base.$extends({
+    query: {
+      async $allOperations({ model, operation, args, query }) {
+        const label = caller.getStore() ?? "untagged";
+        const key = `${label} ${model}.${operation}`;
+        queries[key] = (queries[key] ?? 0) + 1;
+        const startedAt = performance.now();
+        const result = await query(args);
+        (queryMs[label] ??= []).push(performance.now() - startedAt);
+        return result;
+      },
+    },
+  });
 }
diff --git a/lib/instrumentation.ts b/lib/instrumentation.ts
new file mode 100644
index 0000000..99e80b2
--- /dev/null
+++ b/lib/instrumentation.ts
@@ -0,0 +1,37 @@
+// MEASUREMENT ONLY (throwaway worktree, never committed): counts Prisma queries by caller, queue wait,
+// updateAll() duration and event-loop delay.
+import { AsyncLocalStorage } from "node:async_hooks";
+import { writeFileSync } from "node:fs";
+import { monitorEventLoopDelay } from "node:perf_hooks";
+
+export const caller = new AsyncLocalStorage<string>();
+export const queries: Record<string, number> = {};
+export const queueWaitMs: number[] = [];
+export const refreshMs: number[] = [];
+export const queryMs: Record<string, number[]> = {};
+export const submitMs: number[] = [];
+export const loopDelay = monitorEventLoopDelay({ resolution: 5 });
+loopDelay.enable();
+
+const pctl = (arr: number[], p: number) => { const a = [...arr].sort((x, y) => x - y); return a.length ? a[Math.min(a.length - 1, Math.floor(p * a.length))] : null; };
+
+process.on("exit", () => {
+  if (process.env.INSTRUMENTATION_FILE) {
+    const ms = (ns: number) => ns / 1e6;
+    writeFileSync(
+      process.env.INSTRUMENTATION_FILE,
+      JSON.stringify(
+        {
+          queries,
+          queueWaitMs,
+          refreshMs,
+          submitMs,
+          queryMs: Object.fromEntries(Object.entries(queryMs).map(([k, v]) => [k, { n: v.length, p50: pctl(v, 0.5), p95: pctl(v, 0.95) }])),
+          loopDelayMs: { p50: ms(loopDelay.percentile(50)), p95: ms(loopDelay.percentile(95)), max: ms(loopDelay.max) },
+        },
+        null,
+        1,
+      ),
+    );
+  }
+});
