generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id                 String        @id @default(cuid())
  nickname           String
  normalizedNickname String        @unique @map("nicknameNormalizado")
  initials           String        @map("iniciais")
  token              String        @unique
  createdAt          DateTime      @default(now()) @map("criadoEm")
  attempts           Attempt[]
  achievements       Achievement[]

  @@map("Jogador")
}

model Round {
  id           String        @id @default(cuid())
  challengeId  String        @map("desafioId")
  openedAt     DateTime      @map("abertaEm")
  deadline     DateTime?     @map("prazo")
  closedAt     DateTime?     @map("encerradaEm")
  attempts     Attempt[]
  achievements Achievement[]

  @@map("Rodada")
}

model Attempt {
  id         String   @id @default(cuid())
  playerId   String   @map("jogadorId")
  roundId    String   @map("rodadaId")
  number     Int      @map("numero")
  prompt     String
  score      Int      @map("nota")
  evaluation String   @map("avaliacao")
  createdAt  DateTime @default(now()) @map("criadaEm")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([playerId, roundId, number])
  @@map("Tentativa")
}

model Achievement {
  id        String   @id @default(cuid())
  playerId  String   @map("jogadorId")
  roundId   String   @map("rodadaId")
  type      String   @map("tipo")
  createdAt DateTime @default(now()) @map("criadaEm")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([playerId, roundId, type])
  @@map("Conquista")
}
